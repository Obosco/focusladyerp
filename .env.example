# ---------------------------------------------------------------------------
# Supabase — auth. VITE_* values are inlined into the browser bundle at build
# time, so they must be set as Build-time variables on Vercel too. The
# unprefixed copies are what server-side code reads from process.env.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=<project-ref>

# Optional. Only needed by server code that must bypass RLS
# (src/integrations/supabase/client.server.ts). Never expose to the browser.
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Google Sheets — the ERP data layer signs its own OAuth tokens with a service
# account key. Supply exactly one of the two:
#
#   Local dev  -> GOOGLE_SERVICE_ACCOUNT_FILE, a path relative to the project root.
#   Vercel     -> GOOGLE_SERVICE_ACCOUNT_JSON, the key itself. There is no key file
#                 on a serverless host. Paste the raw JSON, or base64 it first to
#                 avoid newline mangling:
#                   base64 -i service-account.json | pbcopy
#
# Remember to share the spreadsheet with the service account's client_email.
# ---------------------------------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON=
