# Server-only Google Sheets configuration.
# These values are never exposed to the browser.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Local development may use admin / admin; production must set a unique password and session secret.
ERP_ADMIN_EMAIL=admin
ERP_ADMIN_PASSWORD=admin
SESSION_SECRET=change-this-session-secret

# Optional member accounts as a JSON array. Each member can sign in with their email.
# ERP_MEMBER_ACCOUNTS=[{"email":"member@example.com","password":"change-me"}]

# Optional compatibility aliases for local development.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=
