# Server-only Google Sheets configuration.
# These values are never exposed to the browser.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Required server-side authentication.
ERP_ADMIN_EMAIL=
ERP_ADMIN_PASSWORD=
SESSION_SECRET=

# Optional compatibility aliases for local development.
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=
